# Rent and Read

erDiagram
    USER ||--o{ RENTAL : makes
    BOOK ||--o{ RENTAL : "is rented"
    RENTAL ||--|| PAYMENT : "has one"
    GENRE ||--o{ BOOK : "categorizes"

    USER {
        uint id PK
        string name
        string email UK
        string password "Hashed"
        datetime created_at
        datetime updated_at
    }

    GENRE {
        uint id PK
        string name UK
        datetime created_at
        datetime updated_at
    }

    BOOK {
        uint id PK
        uint genre_id FK
        string isbn UK
        string title
        string author
        int daily_rental_fee
        int total_stock
        int available_stock
        datetime created_at
        datetime updated_at
    }

    RENTAL {
        uint id PK
        uint user_id FK
        uint book_id FK
        datetime start_date
        datetime end_date
        string status "PENDING, ACTIVE, RETURNED"
        datetime notified_at
        datetime created_at
        datetime updated_at
    }

    PAYMENT {
        uint id PK
        uint rental_id FK
        string xendit_external_id "Reference ID"
        string xendit_invoice_url
        string status "UNPAID, PAID, EXPIRED"
        int amount
        datetime created_at
        datetime updated_at
    }
